import time
import os
from flask import Flask
import MetaTrader5 as mt5

app = Flask(__name__)

# --- CONFIG ---
SYMBOL = "XAUUSD" # Change to your symbol: EURUSD, Boom 1000, etc
LOT_SIZE = 0.01
MAGIC_NUMBER = 123456

# Strategy: Simple Moving Average Cross
FAST_MA = 10
SLOW_MA = 20

def connect_mt5():
    # For local PC, these will be from your.env
    login = int(os.getenv("MT5_LOGIN", 0))
    password = os.getenv("MT5_PASSWORD", "")
    server = os.getenv("MT5_SERVER", "")

    if not mt5.initialize(login=login, password=password, server=server):
        print(f"MT5 initialize failed: {mt5.last_error()}")
        return False
    print("MT5 Connected!")
    return True

def get_signal(symbol):
    # Get last 100 candles
    rates = mt5.copy_rates(symbol, mt5.TIMEFRAME_M1, 0, 100)
    if rates is None or len(rates) < SLOW_MA:
        return None

    closes = [x['close'] for x in rates]
    fast_ma = sum(closes[-FAST_MA:]) / FAST_MA
    slow_ma = sum(closes[-SLOW_MA:]) / SLOW_MA

    if fast_ma > slow_ma:
        return "BUY"
    elif fast_ma < slow_ma:
        return "SELL"
    return None

def trade(symbol, action):
    # Check if we already have a position
    positions = mt5.positions_get(symbol=symbol)
    if positions and len(positions) > 0:
        print(f"Already in position on {symbol}, skipping")
        return

    price = mt5.symbol_info_tick(symbol).ask if action == "BUY" else mt5.symbol_info_tick(symbol).bid
    order_type = mt5.ORDER_TYPE_BUY if action == "BUY" else mt5.ORDER_TYPE_SELL

    request = {
        "action": mt5.TRADE_ACTION_DEAL,
        "symbol": symbol,
        "volume": LOT_SIZE,
        "type": order_type,
        "price": price,
        "sl": 0, # Add your SL
        "tp": 0, # Add your TP
        "deviation": 20,
        "magic": MAGIC_NUMBER,
        "comment": "Axole- Bot",
        "type_time": mt5.ORDER_TIME_GTC,
        "type_filling": mt5.ORDER_FILLING_IOC,
    }
    result = mt5.order_send(request)
    print(f"Trade result: {result}")

@app.route('/')
def home():
    return "Axole- MT5 Bot is Running! Check logs."

def bot_loop():
    if not connect_mt5():
        return

    print(f"Axole- started on {SYMBOL}")
    while True:
        try:
            signal = get_signal(SYMBOL)
            if signal:
                print(f"Signal: {signal}")
                trade(SYMBOL, signal)
            time.sleep(10) # Check every 10 seconds
        except Exception as e:
            print(f"Error: {e}")
            time.sleep(10)

if __name__ == "__main__":
    # Run bot in background and web server for Render to keep alive
    import threading
    threading.Thread(target=bot_loop, daemon=True).start()
    port = int(os.environ.get("PORT", 10000))
    app.run(host="0.0.0.0", port=port)