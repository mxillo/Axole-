import asyncio, json, os
import websockets
from flask import Flask
import threading

app = Flask(__name__)

# --- YOUR FREE DERIV DEMO CONFIG ---
# Get FREE token from: app.deriv.com -> Account Settings -> API Token -> Create DEMO token
DERIV_API_TOKEN = os.getenv("DERIV_TOKEN", "YOUR_DEMO_TOKEN_HERE")
SYMBOL = "frxXAUUSD"  # XAUUSD on Deriv = frxXAUUSD
STAKE = 1  # $1 demo stake - free money

async def deriv_bot():
    print(f"Axole- Deriv Bot Starting for {SYMBOL}...")
    uri = "wss://ws.derivws.com/websockets/v3?app_id=1089"
    
    async with websockets.connect(uri) as ws:
        # 1. Auth with your DEMO token
        await ws.send(json.dumps({"authorize": DERIV_API_TOKEN}))
        auth = json.loads(await ws.recv())
        print("Authorized:", auth)

        # 2. Subscribe to XAUUSD ticks
        await ws.send(json.dumps({"ticks": SYMBOL, "subscribe": 1}))
        
        closes = []
        while True:
            tick_data = json.loads(await ws.recv())
            if "tick" in tick_data:
                price = tick_data["tick"]["quote"]
                closes.append(price)
                if len(closes) > 21:
                    closes.pop(0)
                
                # XAUUSD EMA 9 / 21 Strategy
                if len(closes) == 21:
                    ema9 = sum(closes[-9:]) / 9
                    ema21 = sum(closes[-21:]) / 21
                    
                    print(f"XAUUSD Price: {price} | EMA9: {ema9:.2f} EMA21: {ema21:.2f}")
                    
                    if ema9 > ema21:
                        # BUY CALL - Gold going up
                        print("SIGNAL: BUY XAUUSD")
                        await ws.send(json.dumps({
                            "proposal": 1,
                            "amount": STAKE,
                            "basis": "stake",
                            "contract_type": "CALL",
                            "currency": "USD",
                            "duration": 5,
                            "duration_unit": "m",
                            "symbol": SYMBOL
                        }))
                    elif ema9 < ema21:
                        print("SIGNAL: SELL XAUUSD")
                        await ws.send(json.dumps({
                            "proposal": 1,
                            "amount": STAKE,
                            "basis": "stake",
                            "contract_type": "PUT",
                            "currency": "USD",
                            "duration": 5,
                            "duration_unit": "m",
                            "symbol": SYMBOL
                        }))

            # If proposal received, buy it
            if "proposal" in tick_data:
                await ws.send(json.dumps({"buy": tick_data["proposal"]["id"], "price": STAKE}))
                print("Trade Placed on XAUUSD DEMO!")

@app.route('/')
def home():
    return "Axole- Deriv XAUUSD Bot Running FREE on DEMO!"

def run_bot():
    asyncio.run(deriv_bot())

if __name__ == "__main__":
    threading.Thread(target=run_bot, daemon=True).start()
    port = int(os.environ.get("PORT", 10000))
    app.run(host="0.0.0.0", port=port)